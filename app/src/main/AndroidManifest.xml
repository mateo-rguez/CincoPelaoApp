<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Compartición (BLE + Wi‑Fi Direct). Cada permiso solo en las versiones que lo usan. -->
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- Hasta Android 12L, Wi‑Fi Direct (y hasta Android 11 el escaneo BLE) exigen ubicación -->
    <uses-permission
        android:name="android.permission.ACCESS_FINE_LOCATION"
        android:maxSdkVersion="32" />
    <uses-permission
        android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <!-- Socket TCP sobre Wi‑Fi Direct (permiso normal, se concede al instalar) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- La app funciona sin ellos; solo la compartición los necesita -->
    <uses-feature
        android:name="android.hardware.bluetooth_le"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.wifi.direct"
        android:required="false" />

    <application
        android:name=".HiltApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/cincopelaoico"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/cincopelaoico_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.CincoPelao"
        tools:targetApi="31">
        <activity
            android:name=".ui.notifications.NotificationsActivity"
            android:exported="false"
            android:label="@string/title_activity_notifications"
            android:theme="@style/Theme.CincoPelao" />
        <activity
            android:name=".ui.instances.InstancesActivity"
            android:exported="false"
            android:label="@string/title_activity_instances"
            android:theme="@style/Theme.CincoPelao" />
        <activity
            android:name=".ui.sharing.ReceiveActivity"
            android:exported="false"
            android:label="@string/title_activity_receive"
            android:theme="@style/Theme.CincoPelao" />
        <activity
            android:name=".ui.sharing.TransmitActivity"
            android:exported="false"
            android:label="@string/title_activity_transmit"
            android:theme="@style/Theme.CincoPelao" />
        <activity
            android:name=".ui.subjects.SubjectActivity"
            android:exported="false"
            android:label="@string/title_activity_subject"
            android:theme="@style/Theme.CincoPelao" />
        <activity
            android:name=".ui.subjects.AddEditSubjectActivity"
            android:exported="false"
            android:label="@string/title_activity_add_edit_subject"
            android:theme="@style/Theme.CincoPelao" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.CincoPelao">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>